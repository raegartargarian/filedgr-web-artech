# Copy to .env and fill in. All variables are read at build time by Vite.

# Base URLs of the public chain explorers used for "view on explorer" links
# (vault NFT and transaction links), selected by the vault's ledger in
# src/json/ledger.json. No trailing slash.
VITE_POLYGON_SCANNER=
VITE_XRP_SCANNER=
VITE_ETHEREUM_SCANNER=
